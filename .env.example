# =============================================================================
# Aquilla environment variables. Copy to `.env` and fill in. NEVER commit real
# secrets. VITE_* values are exposed to the browser (safe: URL + anon key only).
# Server secrets live in Supabase Edge Function config, not in the client.
# =============================================================================

# ---- Client (Vite) ----------------------------------------------------------
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# ---- Supabase Edge Functions (set via `supabase secrets set`) ---------------
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically in the Edge runtime; only override them locally if needed.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---- Auth: phone OTP (Twilio) -----------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGE_SERVICE_SID=""

# ---- Auth: social login -----------------------------------------------------
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""

# ---- Stripe Connect ---------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Connect onboarding redirect targets used by stripe-connect-link
STRIPE_CONNECT_REFRESH_URL="http://localhost:8080/pro/onboarding"
STRIPE_CONNECT_RETURN_URL="http://localhost:8080/pro"

# ---- Scheduling -------------------------------------------------------------
# Shared secret the scheduler sends as `x-cron-secret` to cron-auto-confirm.
CRON_SECRET=""
